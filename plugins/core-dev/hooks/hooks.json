{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          { "type": "command", "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/conda-guard.py\"", "timeout": 10 },
          { "type": "command", "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/env-guard.py\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/env-guard.py\"", "timeout": 10 }
        ]
      }
    ]
  }
}
